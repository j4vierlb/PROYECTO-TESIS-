JWT_SECRET=cambia-esta-clave-en-desarrollo
DATABASE_URL=postgresql+psycopg://killbichos:killbichos_dev@localhost:5432/killbichos
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000,http://localhost:5173

# --- Agente de WhatsApp + IA (dejar las claves vacías: NUNCA subir claves reales) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Número del Sandbox de Twilio (o el número de WhatsApp Business real)
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
# URL pública EXACTA configurada en Twilio, ej: https://xxxx.ngrok-free.app/webhooks/whatsapp
TWILIO_WEBHOOK_URL=
# true en producción; false solo para probar en local con curl
TWILIO_VALIDATE_SIGNATURE=true
# Donde Twilio informa si llegó cada mensaje enviado. Vacía = TWILIO_WEBHOOK_URL + /estado
TWILIO_STATUS_CALLBACK_URL=
# Plantillas aprobadas (ContentSid HX...) para escribirle a un cliente que no
# ha escrito en 24 h. Vacías = esos mensajes quedan como "no enviado".
#   Recordatorio: variables {"1": fecha, "2": hora}   Aviso: {"1": texto}
TWILIO_CONTENT_SID_RECORDATORIO=
TWILIO_CONTENT_SID_AVISO=
# Aviso al cliente cuando el panel agenda, reagenda o cancela su visita
WHATSAPP_AVISOS_ACTIVOS=true
# Recordatorio el día anterior a la visita, desde esta hora (Chile)
WHATSAPP_RECORDATORIOS_ACTIVOS=true
WHATSAPP_RECORDATORIO_HORA=18:00

# Empresa que recibe las visitas creadas por WhatsApp (la del seed.sql)
KILLBICHOS_EMPRESA_ID=11111111-1111-1111-1111-111111111111
# Operador fijo para esas visitas. Vacío = el operador libre con menos visitas ese día
KILLBICHOS_OPERADOR_ID=
# Horario de atención (hora de Chile). Días: 0=lunes ... 6=domingo
KILLBICHOS_OPEN_TIME=08:00
KILLBICHOS_CLOSE_TIME=18:00
KILLBICHOS_OPERATING_DAYS=0,1,2,3,4,5

# --- Google Maps en el backend: geocodificación (y foto satelital del croquis) ---
# Clave del proyecto de Google Cloud con Geocoding API y Maps Static API
# habilitadas, SIN restricción de app Android/iOS. Vacía = no se geocodifica.
GOOGLE_MAPS_API_KEY=
