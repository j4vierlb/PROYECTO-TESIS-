# =============================================================================
# Variables de entorno de Kill Bichos IA (docker-compose.yml)
# -----------------------------------------------------------------------------
# Uso:  cp .env.example .env   y completar lo necesario.
# El archivo .env queda fuera de git (.gitignore): las claves reales van SOLO
# ahí. Este .env.example se sube al repo y NO debe tener valores reales.
# =============================================================================

# --- Base de datos (PostgreSQL + PostGIS) ---
POSTGRES_USER=killbichos
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=killbichos

# --- Backend ---
# Clave con que se firman los tokens de sesión. En un servidor real, una
# larga y aleatoria:  openssl rand -hex 32
JWT_SECRET=cambia-esta-clave-larga-y-aleatoria
# Sitios web que pueden llamar a la API desde el navegador (CORS):
# 8080 = panel web en Docker, 5173 = panel en modo desarrollo (npm run dev).
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost:3000

# --- Panel web ---
# Dirección del backend que usa el navegador. Se fija al COMPILAR el panel:
# si se cambia, hay que reconstruir con  docker compose up --build
VITE_API_URL=http://localhost:8000

# --- Agente de WhatsApp + IA (vacías: NUNCA subir claves reales) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
# URL pública EXACTA configurada en Twilio, ej: https://xxxx.ngrok-free.app/webhooks/whatsapp
TWILIO_WEBHOOK_URL=
# true en producción; false solo para probar en local con curl
TWILIO_VALIDATE_SIGNATURE=true

# Empresa que recibe las visitas creadas por WhatsApp (la del seed.sql)
KILLBICHOS_EMPRESA_ID=11111111-1111-1111-1111-111111111111
# Operador fijo para esas visitas. Vacío = el operador libre con menos visitas ese día
KILLBICHOS_OPERADOR_ID=
# Horario de atención (hora de Chile). Días: 0=lunes ... 6=domingo
KILLBICHOS_OPEN_TIME=08:00
KILLBICHOS_CLOSE_TIME=18:00
KILLBICHOS_OPERATING_DAYS=0,1,2,3,4,5
